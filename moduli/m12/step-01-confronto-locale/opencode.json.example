{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "model": "ollama/qwen3.5:9b",
  "small_model": "ollama/qwen3.5:9b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local workshop)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B (local)",
          "limit": {
            "context": 65536,
            "output": 16384
          },
          "options": {
            "reasoningEffort": "none"
          }
        },
        "qwen3-coder:latest": { "name": "Qwen 3 Coder (local)" },
        "gemma4:12b": { "name": "Gemma 4 12B (local)" }
      }
    }
  }
}
